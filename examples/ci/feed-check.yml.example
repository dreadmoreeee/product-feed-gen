# Example only: copy to .github/workflows/feed-check.yml in your own shop repository.
# Fails the build when the product spreadsheet has feed errors.
name: feed-check
on: [push]
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install product-feed-gen
      - run: product-feed-gen products.csv --strict --report markdown --report-file feed-report.md
